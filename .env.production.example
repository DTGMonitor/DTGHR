# ─── DTG HR Hub — Frontend (Vercel production) ───────────────────────────────
# Set these in: Vercel -> Project -> Settings -> Environment Variables.
# Do NOT commit real values. Vite inlines them at BUILD time, so a change here
# requires a redeploy.

# Absolute URL of the backend deployment, including the /api/v1 suffix.
# Required unless you instead add an /api rewrite to vercel.json (see DEPLOYMENT.md
# "Option B"), which avoids CORS entirely.
VITE_API_BASE_URL=https://dtg-hr-hub-be.vercel.app/api/v1

# ─── Microsoft Entra ID (optional) ───────────────────────────────────────────
# The frontend's Vercel URL must also be registered as a redirect URI on the
# Entra app registration (Authentication -> Single-page application).
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
