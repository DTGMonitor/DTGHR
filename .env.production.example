# ─── DTG HR Hub — Frontend (Vercel production) ───────────────────────────────
# Set these in: Vercel -> Project -> Settings -> Environment Variables.
# Do NOT commit real values. Vite inlines them at BUILD time, so a change here
# requires a redeploy.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Microsoft Entra ID (optional) ───────────────────────────────────────────
# Enable the Azure provider under Supabase -> Authentication -> Providers, add
# https://<project-ref>.supabase.co/auth/v1/callback as a redirect URI on the
# Entra app registration, then set this to "true".
VITE_AZURE_SSO_ENABLED=
