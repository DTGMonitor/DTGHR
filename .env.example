# ─── DTG HR Hub — Frontend (local development) ───────────────────────────────
# Copy to .env.local:  cp .env.example .env.local
#
# Vite inlines VITE_* variables at BUILD time. Changing any of them in Vercel
# requires a redeploy before it takes effect.

# Where the API lives.
# Leave unset locally: the default "/api/v1" is proxied to VITE_BACKEND_URL by
# the dev server (see vite.config.ts).
# VITE_API_BASE_URL=

# Backend target for the Vite dev proxy. Only used by `npm run dev`.
VITE_BACKEND_URL=http://localhost:8000

# ─── Microsoft Entra ID (optional) ───────────────────────────────────────────
# Leave both blank to disable SSO. The app still works: the "Sign in with
# Microsoft" button is hidden and email/password login remains available.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
