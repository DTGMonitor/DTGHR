# ─── DTG HR Hub — Frontend (local development) ───────────────────────────────
# Copy to .env.local:  cp .env.example .env.local
#
# Vite inlines VITE_* variables at BUILD time. Changing any of them in Vercel
# requires a redeploy before it takes effect.
#
# There is no backend to point at any more: the app talks to Supabase directly.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Microsoft Entra ID (optional) ───────────────────────────────────────────
# Set to "true" only once the Azure provider is enabled under
# Supabase -> Authentication -> Providers. Leave blank to hide the button;
# email/password sign-in keeps working either way.
VITE_AZURE_SSO_ENABLED=

# ─── Production operations (optional, this machine only) ─────────────────────
# For scripts and tooling run from this machine against the hosted project:
# queueing a test email in email_outbox, calling the send-notifications Edge
# Function, reading delivery errors. The app itself never reads it.
#
# Supabase -> Project Settings -> API -> service_role secret. Put the value in
# .env.local only; never commit it. It bypasses row level security entirely.
#
# Never prefix it with VITE_: Vite would bake it into the browser bundle and
# publish it. Never set it in Vercel. Rotate it in the dashboard if it leaks.
SUPABASE_SERVICE_ROLE_KEY=
